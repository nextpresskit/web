# NextPressKit web: copy to .env.local (git-ignored) and adjust.

# Base URL of the NextPressKit backend (nextpresskit/backend), without a trailing slash.
# Include API_BASE_PATH if the backend sets one (e.g. http://localhost:9090/api).
# Development default when unset: http://localhost:9090 (the backend's APP_PORT).
# Production builds have no default: requests show a configuration error until this is set.
VITE_API_URL=http://localhost:9090

# Public origin of this web app, without a trailing slash (e.g. https://nextpresskit.example).
# Used to build absolute URLs for og:image and other share metadata.
# Development default when unset: http://localhost:3000. Production builds omit og:image until this is set.
VITE_SITE_URL=http://localhost:3000

# Optional page title override.
# VITE_APP_TITLE=NextPressKit
